# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy compatibility only:
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_key

# Canonical public URL
VITE_SITE_URL=https://tricentric-integration-lyart.vercel.app

# Stripe Payment Link (public URL; never expose Stripe secret keys in VITE_* variables)
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# Optional Chrome built-in AI. Keep false in production unless explicitly tested.
VITE_ENABLE_LOCAL_AI=false

# Supabase Edge Function secrets (never expose in VITE_* variables)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
